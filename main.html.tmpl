<!DOCTYPE html>
<html lang="{{.Meta.Language}}">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <title>{{.Info.Name}} | {{.Info.Title}}</title>

        <link rel="icon" href="/favicon.ico" type="image/x-icon" />
        <link rel="stylesheet" href="{{.Meta.CSS}}" />

        <meta name="description" content="{{.Summary.Data}}" />
        <meta name="keywords" content="{{.Info.Keywords}}" />
        <meta name="author" content="{{.Info.Name}}" />
        <meta
            name="robots"
            content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
        />
        <meta
            name="googlebot"
            content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
        />

        <meta name="geo.region" content="CU-03" />
        <meta name="geo.placename" content="Havana" />

        <link rel="canonical" href="https://xeraph-dev/{{.Meta.Language}}/" />
        <link rel="alternate" hreflang="en" href="https://xeraph-dev/en/" />
        <link rel="alternate" hreflang="es" href="https://xeraph-dev/es/" />
        <link rel="alternate" hreflang="x-default" href="https://xeraph-dev/en/" />

        <meta property="og:locale" content="{{.Meta.Language}}" />
        <meta property="og:type" content="profile" />
        <meta property="og:title" content="{{.Info.Name}} | {{.Info.Title}}" />
        <meta property="og:description" content="{{.Summary.Data}}" />
        <meta property="og:url" content="https://xeraph.dev/" />
        <meta property="og:site_name" content="{{.Info.Name}}" />
        <meta property="og:image" content="https://xeraph.dev/og.png" />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta property="og:image:alt" content="{{.Info.Name}}, {{.Info.Title}}" />
        <meta property="profile:first_name" content="{{.Info.FirstName}}" />
        <meta property="profile:last_name" content="{{.Info.LastName}}" />
        <meta property="profile:username" content="xeraph-dev" />

        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content="{{.Info.Name}} | {{.Info.Title}}" />
        <meta name="twitter:description" content="{{.Summary.Data}}" />
        <meta name="twitter:image" content="https://xeraph.dev/og.png" />
        <meta name="twitter:image:alt" content="{{.Info.Name}}, {{.Info.Title}}" />
    </head>
    <body>
        <a class="skip-link" href="#main">{{.Meta.UI.SkipToContent}}</a>
        <header>
            <h1>{{.Info.Name}}</h1>
            <p class="main-skills">{{.Info.Title}}</p>
            <p class="location">{{.Info.Location}}</p>
            <ul class="links">
                {{range .Info.Links}}
                    <li><a href="{{.URL}}" rel="me">{{.Label}}</a></li>
                {{end}}
                <li>
                    <a
                        download="cv-{{.Info.Slug}}-{{.Meta.Language}}.pdf"
                        type="application/pdf"
                        rel="me"
                        href="/{{.Meta.Language}}/cv.pdf"
                    >
                            CV
                    </a>
                </li>
            </ul>
        </header>

        <main id="main">
            <section id="summary" aria-labelledby="summary-title">
                <h2 id="summary-title">{{.Summary.Title}}</h2>
                <p>{{.Summary.Data}}</p>
            </section>

            <section id="experience" aria-labelledby="experience-title">
                <h2 id="experience-title">{{.Experience.Title}}</h2>
                {{range .Experience.Data}}
                    <article>
                        <h3>{{.Title}}, {{.Employer}}</h3>
                        <p class="experience-dates">
                            <time datetime="{{.StartDate.DateTime}}">{{.StartDate.Month}} {{.StartDate.Year}}</time>
                            &ndash;
                            {{if .EndDate}}<time datetime="{{.EndDate.DateTime}}">{{.EndDate.Month}} {{.EndDate.Year}}</time>
                            {{else}}{{.Meta.UI.Present}}{{end}} &middot; {{.Location}}
                            {{if .Note}} &middot; {{.Note}}{{end}}
                        </p>
                        {{range .Projects}}
                            <section>
                                {{if .Title}}<h4>{{.Title}}</h4>{{end}}
                                <ul>
                                    {{range .Items}}
                                        <li>{{.}}</li>
                                    {{end}}
                                </ul>
                            </section>
                        {{end}}
                    </article>
                {{end}}
            </section>

            <section id="projects" aria-labelledby="projects-title">
                <h2 id="projects-title">{{.Projects.Title}}</h2>
                <ul>
                    {{range .Projects.Data}}
                        <li>
                            <a href="{{.Link.URL}}">{{.Name}}</a> {{.Description}}
                        </li>
                    {{end}}
                </ul>
            </section>

            <section id="education" aria-labelledby="education-title">
                <h2 id="education-title">{{.Educations.Title}}</h2>
                {{range .Educations.Data}}
                    <article>
                        <h3>{{.Name}}{{if .Status}} ({{.Status}}){{end}}</h3>
                        <p>
                            {{.Institution}} &middot;
                            <time>{{.StartDate.Month}} {{.StartDate.Year}}</time>
                        </p>
                    </article>
                {{end}}
            </section>

            <section id="skills" aria-labelledby="skills-title">
                <h2 id="skills-title">{{.Skills.Title}}</h2>
                <dl>
                    {{range .Skills.Data}}
                        <dt>{{.Name}}</dt>
                        <dd>
                            {{range $i, $item := .Items}}
                                {{if $i}}• {{end}}{{$item}}
                            {{end}}
                        </dd>
                    {{end}}
                </dl>
            </section>

            <section id="languages" aria-labelledby="languages-title">
                <h2 id="languages-title">{{.Languages.Title}}</h2>
                <ul>
                    {{range .Languages.Data}}
                        <li>{{.Name}} ({{.Level}})</li>
                    {{end}}
                </ul>
            </section>
        </main>
    </body>
</html>
